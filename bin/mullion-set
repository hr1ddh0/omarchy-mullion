#!/usr/bin/python3
"""Change Mullion settings and apply them.

    mullion-set rounding=14 shadow=false
    mullion-set --get rounding
    mullion-set --list

Writes ~/.config/omarchy/mullion.conf, preserving its comments and ordering,
then applies whatever the changed keys affect: a Hyprland reload for anything
the window config reads, and the window-button sweep when that setting moves.
The settings panel drives this, so the panel and the command line cannot drift.

Every key and value is checked against the schema in mullionlib before it can
reach the file. The panel, a keybinding and a terminal all arrive here, so this
is the one place that decides what is allowed to be written; a name that is not
a setting, a number out of range, or a value carrying a newline is refused
rather than stored and read back later by the Hyprland config.
"""
import importlib.util
import os
import sys


def _load_lib():
    """Find the shared safety library, in a checkout or installed."""
    here = os.path.dirname(os.path.abspath(__file__))
    for candidate in (os.path.join(here, "mullionlib.py"),
                      os.path.expanduser("~/.local/share/mullion/lib/mullionlib.py")):
        if os.path.isfile(candidate):
            spec = importlib.util.spec_from_file_location("mullionlib", candidate)
            module = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(module)
            return module
    sys.exit("mullion-set: mullionlib.py not found; reinstall Mullion")


mfs = _load_lib()

CONF_DIR = os.path.expanduser("~/.config/omarchy")
CONF_NAME = "mullion.conf"
DEFAULTS = os.path.join(os.path.dirname(os.path.abspath(__file__)),
                        os.pardir, "config", "mullion.conf")

# Keys whose change needs the app window-button sweep re-run.
APP_BUTTON_KEYS = {"hide_app_window_buttons"}

# Switching platform should look like that platform, so the dimensions each one
# uses come along with it. Anything the user then tunes by hand stays tuned,
# because only a style change writes these.
STYLE_PRESETS = {
    "macos": {"bar_height": 28, "button_size": 12, "rounding": 10},
    "windows": {"bar_height": 32, "button_size": 14, "rounding": 8},
    "none": {"bar_height": 28, "rounding": 10},
}


def parse(text):
    values = {}
    for line in (text or "").splitlines():
        stripped = line.strip()
        if not stripped or stripped.startswith("#") or "=" not in stripped:
            continue
        key, _, raw = stripped.partition("=")
        values[key.strip()] = raw.strip()
    return values


def current_text(dirfd):
    """The settings file as it stands, creating it from defaults if absent."""
    text = mfs.read_text_at(dirfd, CONF_NAME, missing_ok=True)
    if text is not None:
        return text
    source = os.path.normpath(DEFAULTS)
    if os.path.isfile(source):
        with open(source, "r", encoding="utf-8") as handle:
            text = handle.read()
    else:
        text = ""
    mfs.write_atomic(dirfd, CONF_NAME, text, mode=0o644)
    return text


def rewrite(text, updates):
    """Replace the values in place, keeping comments and key order intact."""
    remaining = dict(updates)
    out = []
    for line in text.splitlines():
        stripped = line.strip()
        if stripped and not stripped.startswith("#") and "=" in stripped:
            key = stripped.split("=", 1)[0].strip()
            if key in remaining:
                out.append("%s = %s" % (key, remaining.pop(key)))
                continue
        out.append(line)
    # Anything not already present is appended rather than silently dropped.
    for key, value in remaining.items():
        out.append("%s = %s" % (key, value))
    return "\n".join(out) + "\n"


def apply(changed):
    # Hyprland re-reads the file on reload, and the plugin's Lua config reads
    # every window/title-bar value straight out of it.
    mfs.run([mfs.tool("hyprctl"), "reload"])

    if changed & APP_BUTTON_KEYS:
        here = os.path.dirname(os.path.abspath(__file__))
        local = os.path.join(here, "use-system-titlebars")
        try:
            sweep = local if os.path.isfile(local) else mfs.helper("use-system-titlebars")
        except mfs.MullionError:
            return
        mfs.run([sweep])


def main():
    args = sys.argv[1:]
    if not args:
        sys.exit(__doc__.strip())

    dirfd = mfs.owned_dir(CONF_DIR, create=True, mode=0o755)
    try:
        if args[0] == "--list":
            for key, value in parse(current_text(dirfd)).items():
                print("%s=%s" % (key, value))
            return 0

        if args[0] == "--get":
            values = parse(current_text(dirfd))
            print(values.get(args[1], "") if len(args) > 1 else "")
            return 0

        updates = {}
        for arg in args:
            if "=" not in arg:
                sys.exit("expected key=value, got %r" % arg)
            key, _, value = arg.partition("=")
            key, value = mfs.require_conf_pair(key, value)
            updates[key] = value

        if "window_style" in updates:
            preset = STYLE_PRESETS.get(updates["window_style"], {})
            for key, value in preset.items():
                if key not in updates:
                    updates[key] = mfs.require_conf_pair(key, str(value))[1]

        text = rewrite(current_text(dirfd), updates)
        mfs.write_atomic(dirfd, CONF_NAME, text, mode=0o644)
    except mfs.MullionError as exc:
        sys.exit("mullion-set: %s" % exc)
    finally:
        os.close(dirfd)

    apply(set(updates))
    for key, value in updates.items():
        print("%s = %s" % (key, value))
    return 0


if __name__ == "__main__":
    sys.exit(main())
