#!/usr/bin/python3
"""Snap the focused window to a half / full / centered region of its monitor.

    mullion-snap left | right | top | bottom | full | center [window-address]

Acts on the focused window unless an explicit Hyprland address is given.

Reads the focused monitor's real geometry and its reserved area (the bar), so
this works on any resolution, any scale, and any bar position instead of
assuming one screen size.

The region name and the window address both end up inside a Lua expression
handed to `hyprctl dispatch`, so both are checked against a fixed set before
they get anywhere near it: the region against the list below, the address
against Hyprland's handle format.
"""
import importlib.util
import json
import os
import subprocess
import sys


def _load_lib():
    here = os.path.dirname(os.path.abspath(__file__))
    for candidate in (os.path.join(here, "mullionlib.py"),
                      os.path.expanduser("~/.local/share/mullion/lib/mullionlib.py")):
        if os.path.isfile(candidate):
            spec = importlib.util.spec_from_file_location("mullionlib", candidate)
            module = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(module)
            return module
    sys.exit("mullion-snap: mullionlib.py not found; reinstall Mullion")


mfs = _load_lib()
HYPRCTL = mfs.tool("hyprctl")

REGIONS = (
    "left", "right", "top", "bottom", "full", "center",
    "topleft", "topright", "bottomleft", "bottomright",
)

# Pressing a direction composes with where the window already is, the way
# Windows Snap does: a window on the left half pushed up becomes the top-left
# quarter, and pushed down again becomes the left half.
COMPOSE = {
    ("left",   "top"):    "topleft",
    ("left",   "bottom"): "bottomleft",
    ("right",  "top"):    "topright",
    ("right",  "bottom"): "bottomright",
    ("top",    "left"):   "topleft",
    ("top",    "right"):  "topright",
    ("bottom", "left"):   "bottomleft",
    ("bottom", "right"):  "bottomright",
    # From a quarter, the perpendicular direction walks back to a half.
    ("topleft",     "bottom"): "bottomleft",
    ("topleft",     "right"):  "topright",
    ("topright",    "bottom"): "bottomright",
    ("topright",    "left"):   "topleft",
    ("bottomleft",  "top"):    "topleft",
    ("bottomleft",  "right"):  "bottomright",
    ("bottomright", "top"):    "topright",
    ("bottomright", "left"):   "bottomleft",
}


def hyprctl_json(*args):
    out = mfs.run([HYPRCTL, "-j", *args], check=True)
    return json.loads(out.stdout)


def focused_monitor(monitors=None):
    monitors = monitors if monitors is not None else hyprctl_json("monitors")
    return next((m for m in monitors if m.get("focused")), None) or monitors[0]


def monitor_bounds(monitor):
    """Full monitor rectangle in layout coordinates, logical pixels."""
    scale = monitor.get("scale") or 1
    return (monitor["x"], monitor["y"],
            int(monitor["width"] / scale), int(monitor["height"] / scale))


def usable_area(monitor):
    """Monitor rectangle minus whatever the bar reserves."""
    mx, my, mw, mh = monitor_bounds(monitor)
    # reserved = [left, top, right, bottom]: the space the bar takes.
    left, top, right, bottom = (monitor.get("reserved") or [0, 0, 0, 0])[:4]
    return (mx + left, my + top, mw - left - right, mh - top - bottom)


def titlebar_height():
    """Height hyprbars draws ABOVE a window, or 0 when it isn't loaded.

    hyprbars paints its bar above the window's reported position, so a window
    placed flush with the top of the usable area would push its title bar up
    underneath the Omarchy bar. Every placement reserves this much room.
    """
    try:
        out = mfs.run([HYPRCTL, "getoption", "plugin:hyprbars:bar_height"], timeout=2)
        for line in out.stdout.splitlines():
            if line.strip().startswith("int:"):
                return max(0, int(line.split(":", 1)[1].strip()))
    except Exception:
        pass
    return 0


def placement_boxes(monitor, bar=None):
    """Region boxes adjusted so window + title bar together fill the region."""
    bar = titlebar_height() if bar is None else bar
    return {
        name: (x, y + bar, w, max(1, h - bar))
        for name, (x, y, w, h) in region_boxes(monitor).items()
    }


def region_boxes(monitor):
    """Every named region as (x, y, w, h), in logical pixels."""
    ux, uy, uw, uh = usable_area(monitor)
    hw, hh = uw // 2, uh // 2
    return {
        "left":        (ux,      uy,      hw,      uh),
        "right":       (ux + hw, uy,      uw - hw, uh),
        "top":         (ux,      uy,      uw,      hh),
        "bottom":      (ux,      uy + hh, uw,      uh - hh),
        "topleft":     (ux,      uy,      hw,      hh),
        "topright":    (ux + hw, uy,      uw - hw, hh),
        "bottomleft":  (ux,      uy + hh, hw,      uh - hh),
        "bottomright": (ux + hw, uy + hh, uw - hw, uh - hh),
        "full":        (ux,      uy,      uw,      uh),
        "center":      (ux + uw // 4, uy + uh // 8, uw // 2, uh * 3 // 4),
    }


def window_geometry(address):
    for client in hyprctl_json("clients"):
        if client.get("address") == address:
            return (client["at"][0], client["at"][1], client["size"][0], client["size"][1])
    return None


def current_region(geometry, boxes, tolerance=8):
    """Which named region the window already occupies, or "" if none."""
    if not geometry:
        return ""
    for name, box in boxes.items():
        if all(abs(a - b) <= tolerance for a, b in zip(geometry, box)):
            return name
    return ""


def dispatch(lua):
    mfs.run([HYPRCTL, "dispatch", lua])


def main():
    exact = False
    if len(sys.argv) >= 2 and sys.argv[1] == "--exact":
        # Dragging to an edge means that edge, full stop. Composition is for
        # the arrow keys, where pressing a second direction refines the first.
        exact = True
        del sys.argv[1]

    if len(sys.argv) >= 3 and sys.argv[1] == "--box":
        if sys.argv[2] not in REGIONS:
            sys.exit("unknown region " + sys.argv[2])
        print(*region_boxes(focused_monitor())[sys.argv[2]])
        return

    if len(sys.argv) not in (2, 3) or sys.argv[1] not in REGIONS:
        sys.exit("usage: mullion-snap [--exact] " + " | ".join(REGIONS) + " [window-address]")
    region = sys.argv[1]

    try:
        if len(sys.argv) == 3:
            # Checked before use: this is spliced into a Lua expression below.
            address = mfs.require_window_address(sys.argv[2])
            clients = hyprctl_json("clients")
            if not any(c.get("address") == address for c in clients):
                sys.exit("no window with address %s" % address)
        else:
            address = hyprctl_json("activewindow").get("address")
            if not address:
                sys.exit("no focused window")
            # Hyprland's own answer, checked all the same, so a single code
            # path decides what may be embedded.
            address = mfs.require_window_address(address)
    except mfs.MullionError as exc:
        sys.exit("mullion-snap: %s" % exc)

    monitor = focused_monitor()
    # Preview/reporting uses the visual region; placement insets the title bar.
    boxes = placement_boxes(monitor)

    # Compose with the window's current region so arrows behave like Windows.
    if not exact and region in ("left", "right", "top", "bottom"):
        current = current_region(window_geometry(address), boxes)
        region = COMPOSE.get((current, region), region)

    x, y, w, h = boxes[region]

    win = 'address:%s' % address
    # Snapping only means anything for a floating window; a tiled one is placed
    # by the layout and would snap straight back.
    dispatch('hl.dsp.window.float({ window = "%s", action = "enable" })' % win)
    dispatch('hl.dsp.window.resize({ window = "%s", x = %d, y = %d })' % (win, w, h))
    dispatch('hl.dsp.window.move({ window = "%s", x = %d, y = %d })' % (win, x, y))


if __name__ == "__main__":
    main()
