#!/bin/bash
# Rebuild the hyprbars title-bar plugin against the running Hyprland.
#
# Hyprland plugins are tied to the exact Hyprland build they were compiled
# against, so run this after an `omarchy update` that bumps Hyprland. Until you
# do, title bars simply won't appear -- nothing else breaks.
set -euo pipefail

DEST="$HOME/.local/share/hyprland/plugins/hyprbars.so"
WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT

HL_COMMIT=$(hyprctl version -j | sed -n 's/.*"commit": *"\([^"]*\)".*/\1/p')
[[ -n $HL_COMMIT ]] || { echo "Could not read the Hyprland commit from hyprctl."; exit 1; }
echo "Hyprland commit: $HL_COMMIT"

git clone --quiet --depth 1 https://github.com/hyprwm/hyprland-plugins.git "$WORK/hlp"

# hyprpm.toml pins each Hyprland commit to the plugin commit that builds against it.
PIN=$(grep -F "$HL_COMMIT" "$WORK/hlp/hyprpm.toml" | grep -oP '(?<=", ")[0-9a-f]{40}' | head -1)
if [[ -z $PIN ]]; then
  echo "No pin for this Hyprland commit yet; building from the latest plugin source."
else
  echo "Plugin commit:   $PIN"
  git -C "$WORK/hlp" fetch --quiet --depth 1 origin "$PIN"
  git -C "$WORK/hlp" checkout --quiet FETCH_HEAD
fi

# Local patches. Each is optional: a patch that no longer applies is skipped
# with a note rather than failing the build.
# Look beside the script first (running from a checkout), then where the
# installer puts them.
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
for candidate in "$SELF_DIR/../patches" "$HOME/.local/share/cupertino/patches"; do
  if [[ -d $candidate ]]; then PATCHES="$candidate"; break; fi
done

if [[ -n ${PATCHES:-} && -d $PATCHES ]]; then
  echo "Applying local patches:"
  for patch in "$PATCHES"/*.py; do
    [[ -e $patch ]] || continue
    python3 "$patch" "$WORK/hlp/hyprbars/barDeco.cpp" || true
  done
fi

make -C "$WORK/hlp/hyprbars" all >/dev/null
mkdir -p "$(dirname "$DEST")"
install -m755 "$WORK/hlp/hyprbars/hyprbars.so" "$DEST"
echo "Installed $DEST"

# A config reload will NOT re-load a plugin that was unloaded mid-session --
# only an explicit `plugin load` does. Relying on the reload alone leaves you
# with no title bars until the next login.
hyprctl plugin unload "$DEST" >/dev/null 2>&1 || true
sleep 1
hyprctl plugin load "$DEST" >/dev/null 2>&1 || true
sleep 1
# Now reload the config so the plugin's Lua API is visible and the buttons
# register against it.
hyprctl reload >/dev/null 2>&1 || true
sleep 1

if hyprctl plugin list 2>/dev/null | grep -q hyprbars; then
  echo "Reloaded. Title bars are back."
else
  echo "The plugin did not load. Log out and back in, or check: hyprctl plugin list"
  exit 1
fi
