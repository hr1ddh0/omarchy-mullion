#!/usr/bin/python3
"""Drag a window to a screen edge to snap it there, with a live preview.

    mullion-drag-snap start   # bound to SUPER + left-mouse press
    mullion-drag-snap end     # bound to the matching release

While the mouse button is held, a watcher follows the cursor and asks the
Mullion bar widget to draw a translucent highlight over the region the window
would land in. On release, the window is snapped to that region.

Hyprland has no drag events, so the button bindings mark the drag and the
cursor is polled over Hyprland's command socket, about 0.03 ms per read, so
following it at 60 Hz costs nothing, and only for as long as the button is down.

This runs from Hyprland's exec and from inside hyprbars, so it inherits an
environment it does not control: every executable is resolved from a root-owned
system directory, XDG_RUNTIME_DIR is checked before any path is built from it,
and the three runtime files are opened without following links.
"""
import importlib.util
import json
import os
import socket
import subprocess
import sys
import time


def _load_lib():
    here = os.path.dirname(os.path.abspath(__file__))
    for candidate in (os.path.join(here, "mullionlib.py"),
                      os.path.expanduser("~/.local/share/mullion/lib/mullionlib.py")):
        if os.path.isfile(candidate):
            spec = importlib.util.spec_from_file_location("mullionlib", candidate)
            module = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(module)
            return module
    sys.exit("mullion-drag-snap: mullionlib.py not found; reinstall Mullion")


mfs = _load_lib()
HERE = os.path.dirname(os.path.abspath(__file__))

# Checked rather than taken as given: everything below is a path built from it.
# A relative or traversing value, or a directory somebody else owns, is refused
# outright instead of quietly becoming somewhere we did not mean to write.
try:
    RUNTIME = mfs.require_env_dir("XDG_RUNTIME_DIR", "/run/user/%d" % os.getuid())
except mfs.MullionError as exc:
    sys.exit("mullion-drag-snap: %s" % exc)

STATE_NAME = "mullion-drag.json"
# Holds the running watcher's pid. SUPER+dragging a title bar fires both the
# Hyprland binding and hyprbars' own hook, so "start" can arrive twice for one
# drag; without this each would get its own watcher, doubling the IPC and
# letting the two fight over the preview.
LOCK_NAME = "mullion-drag.pid"
# Overwritten at the start of each drag, so it never grows. Read it with
# `cat $XDG_RUNTIME_DIR/mullion-drag.log` if snapping ever misbehaves.
LOG_NAME = "mullion-drag.log"
STATE = os.path.join(RUNTIME, STATE_NAME)


def runtime_dir():
    """A fresh descriptor for the runtime directory, verified on every open."""
    return mfs.owned_dir(RUNTIME)


def log(message, reset=False):
    try:
        fd = runtime_dir()
        try:
            previous = "" if reset else (mfs.read_text_at(fd, LOG_NAME, missing_ok=True) or "")
            mfs.write_atomic(fd, LOG_NAME, previous + message + "\n", mode=0o600)
        finally:
            os.close(fd)
    except Exception:
        pass


def settings():
    """Read ~/.config/omarchy/mullion.conf. Missing keys use the defaults."""
    values = {"drag_snap": True, "snap_edge": 10, "snap_corner": 140}
    path = os.path.expanduser("~/.config/omarchy/mullion.conf")
    try:
        for line in open(path):
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            key, raw = (part.strip() for part in line.split("=", 1))
            if raw in ("true", "false"):
                values[key] = raw == "true"
            else:
                try:
                    values[key] = int(raw)
                except ValueError:
                    values[key] = raw
    except OSError:
        pass
    return values


SETTINGS = settings()
# How close to an edge counts as "on" it, and how far along an edge still
# counts as its corner. Clamped, because these come out of a file the user
# edits and a wild value would make every drag snap or none at all.
EDGE = max(1, min(200, int(SETTINGS.get("snap_edge", 10) or 10)))
CORNER_SPAN = max(1, min(600, int(SETTINGS.get("snap_corner", 140) or 140)))
# Ignore a drag that never really moved, so a plain SUPER+click near an edge
# does not rearrange anything.
MIN_TRAVEL = 24
POLL_SECONDS = 1 / 60
# Floor between overlay updates, so a fast sweep across corners cannot spawn a
# burst of IPC processes.
MIN_UPDATE_SECONDS = 0.05
# Safety net: never let a watcher outlive its drag if a release is missed.
MAX_DRAG_SECONDS = 120


def hypr(request):
    """Talk to Hyprland's command socket directly; far cheaper than hyprctl."""
    sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE") or ""
    # Part of a filesystem path, so it may only be a plain name.
    if not sig or "/" in sig or sig in (".", ".."):
        raise OSError("HYPRLAND_INSTANCE_SIGNATURE is not usable")
    path = os.path.join(RUNTIME, "hypr", sig, ".socket.sock")
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
        sock.connect(path)
        sock.sendall(request.encode())
        chunks = []
        while True:
            chunk = sock.recv(8192)
            if not chunk:
                break
            chunks.append(chunk)
    return b"".join(chunks).decode()


def cursor_pos():
    try:
        data = json.loads(hypr("j/cursorpos"))
        return data["x"], data["y"]
    except Exception:
        return None


def monitors():
    return json.loads(hypr("j/monitors"))


def focused_monitor(mons):
    return next((m for m in mons if m.get("focused")), None) or mons[0]


def monitor_at(mons, x, y):
    for mon in mons:
        scale = mon.get("scale") or 1
        mw, mh = int(mon["width"] / scale), int(mon["height"] / scale)
        if mon["x"] <= x < mon["x"] + mw and mon["y"] <= y < mon["y"] + mh:
            return mon
    return focused_monitor(mons)


def region_at(mons, x, y):
    """Which snap region the cursor is currently pointing at, or None.

    Uses full monitor bounds rather than the usable area, so dragging into the
    strip behind the bar still registers as the top edge.
    """
    mon = monitor_at(mons, x, y)
    scale = mon.get("scale") or 1
    mx, my = mon["x"], mon["y"]
    mw, mh = int(mon["width"] / scale), int(mon["height"] / scale)

    left = x <= mx + EDGE
    right = x >= mx + mw - 1 - EDGE
    top = y <= my + EDGE
    bottom = y >= my + mh - 1 - EDGE
    upper = y <= my + CORNER_SPAN
    lower = y >= my + mh - CORNER_SPAN

    if left and upper:
        return "topleft"
    if left and lower:
        return "bottomleft"
    if right and upper:
        return "topright"
    if right and lower:
        return "bottomright"
    if left:
        return "left"
    if right:
        return "right"
    if top:
        return "full"
    if bottom:
        return "bottom"
    return None


def snap_path():
    """Where mullion-snap lives: beside us, or in the install location."""
    local = os.path.join(HERE, "mullion-snap")
    if os.path.isfile(local):
        return local
    return mfs.helper("mullion-snap")


def snap_module():
    """Import mullion-snap so its geometry runs in-process.

    Shelling out to `mullion-snap --box` cost ~23ms of interpreter start on every
    zone change, a visible hitch at the moment crossing an edge has to feel
    instant. Importing it keeps one source of truth for the geometry while
    making a zone change pure arithmetic.
    """
    from importlib.machinery import SourceFileLoader

    loader = SourceFileLoader("mullion_snap", snap_path())
    spec = importlib.util.spec_from_loader("mullion_snap", loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def titlebar_height():
    """hyprbars' bar height, read over the socket rather than via hyprctl."""
    try:
        return max(0, int(json.loads(hypr("j/getoption plugin:hyprbars:bar_height"))["int"]))
    except Exception:
        return 0


def overlay(method, payload=None, wait=False):
    """Ask the bar widget to show or hide the preview.

    Fire-and-forget by default: the reply is of no use mid-drag, and waiting on
    it stalled the cursor loop for ~21ms every time the region changed.
    """
    try:
        args = [mfs.tool("omarchy-shell"), "-q", "mullion-preview", method]
    except mfs.MullionError as exc:
        log("overlay %s unavailable: %s" % (method, exc))
        return
    if payload is not None:
        args.append(json.dumps(payload))
    # omarchy-shell needs OMARCHY_PATH, and this runs from Hyprland's exec
    # where we cannot count on the session environment carrying it. PATH is
    # replaced rather than inherited for the same reason.
    env = dict(os.environ)
    env["PATH"] = mfs.SAFE_PATH
    env.setdefault("OMARCHY_PATH", "/usr/share/omarchy")
    try:
        proc = subprocess.Popen(args, stdout=subprocess.DEVNULL,
                                stderr=subprocess.DEVNULL, env=env)
        if wait:
            proc.wait(timeout=2)
    except Exception as exc:
        log("overlay %s failed: %s" % (method, exc))


def watch():
    """Follow the cursor until the drag ends, previewing the target region."""
    deadline = time.time() + MAX_DRAG_SECONDS
    mons = monitors()

    # Everything the loop needs is computed once here, so following the cursor
    # is arithmetic and a socket read; no process ever starts per frame.
    snap = snap_module()
    # Keyed by name: object identity happens to work here only because every
    # lookup returns an element of this same list, which is too subtle to rely
    # on.
    boxes = {mon.get("name", str(i)): snap.region_boxes(mon)
             for i, mon in enumerate(mons)}

    shown = None            # region the overlay is currently displaying
    pending = None          # region seen most recently
    last_sent = 0.0

    while os.path.exists(STATE) and time.time() < deadline:
        frame = time.time()
        pos = cursor_pos()

        if pos:
            mon = monitor_at(mons, *pos)
            pending = region_at(mons, *pos)

            # Sweeping across a corner can cross several regions in a few
            # frames. Rate-limiting keeps that from starting a burst of
            # processes, while the trailing send below guarantees the final
            # region is always the one drawn.
            if pending != shown and frame - last_sent >= MIN_UPDATE_SECONDS:
                if pending:
                    box = boxes.get(mon.get("name", ""), {}).get(pending)
                    if box:
                        overlay("show", {"x": box[0], "y": box[1],
                                         "w": box[2], "h": box[3]})
                else:
                    overlay("hide")
                shown = pending
                last_sent = frame

        # Sleep out the remainder of the frame rather than a flat interval, so
        # the poll rate holds steady regardless of how long the work took.
        time.sleep(max(0.0, POLL_SECONDS - (time.time() - frame)))

    # Trailing send: if the drag ended on a region we had rate-limited away,
    # the preview would otherwise be left showing the wrong one.
    if pending != shown and pending:
        final_mon = monitor_at(mons, *(cursor_pos() or (0, 0)))
        box = boxes.get(final_mon.get("name", ""), {}).get(pending)
        if box:
            overlay("show", {"x": box[0], "y": box[1], "w": box[2], "h": box[3]})
        shown = pending

    if shown:
        overlay("hide", wait=True)


def watcher_running():
    """Is a watcher from this drag still alive?"""
    try:
        fd = runtime_dir()
    except mfs.MullionError:
        return False
    try:
        raw = mfs.read_text_at(fd, LOCK_NAME, missing_ok=True)
    except mfs.MullionError:
        return False
    finally:
        os.close(fd)
    try:
        pid = int((raw or "").strip())
    except ValueError:
        return False
    try:
        os.kill(pid, 0)          # signal 0 only tests for existence
        return True
    except OSError:
        return False


def start():
    if not SETTINGS.get("drag_snap", True):
        return
    if watcher_running():
        # The other half of the same drag already started one.
        return
    pos = cursor_pos()
    log("drag start at %s" % (pos,), reset=True)
    if not pos:
        return

    fd = runtime_dir()
    try:
        mfs.write_atomic(fd, STATE_NAME,
                         json.dumps({"x": pos[0], "y": pos[1], "t": time.time()}),
                         mode=0o600)
    finally:
        os.close(fd)

    # Detach so the key binding returns immediately and the native window drag
    # is not held up behind us.
    if os.fork() != 0:
        return
    os.setsid()
    try:
        fd = runtime_dir()
        try:
            mfs.write_atomic(fd, LOCK_NAME, str(os.getpid()), mode=0o600)
        finally:
            os.close(fd)
        watch()
    finally:
        try:
            fd = runtime_dir()
            try:
                mfs.remove_at(fd, LOCK_NAME)
            finally:
                os.close(fd)
        except Exception:
            pass
        os._exit(0)


def end():
    if not SETTINGS.get("drag_snap", True):
        return
    began = None
    fd = runtime_dir()
    try:
        raw = mfs.read_text_at(fd, STATE_NAME, missing_ok=True)
        if raw:
            began = json.loads(raw)
            # A drag that never ended (a crash, a missed release) leaves this
            # behind. Measuring travel from an hour-old position would snap a
            # window the user only just clicked.
            if time.time() - float(began.get("t", 0)) > MAX_DRAG_SECONDS:
                log("ignoring a stale drag record")
                began = None
        # Removing the state file is what tells the watcher to stop.
        mfs.remove_at(fd, STATE_NAME)
    except (mfs.MullionError, ValueError, TypeError):
        began = None
    finally:
        os.close(fd)
    overlay("hide")

    if not began:
        return
    pos = cursor_pos()
    if not pos:
        return
    travelled = abs(pos[0] - began["x"]) + abs(pos[1] - began["y"])
    if travelled < MIN_TRAVEL:
        log("drag end: only travelled %d px, ignoring" % travelled)
        return

    mons = monitors()
    region = region_at(mons, *pos)
    log("drag end at %s, travelled %d, region %s" % (pos, travelled, region))
    if region:
        # --exact, because dragging to an edge means that edge. Composition
        # belongs to the arrow keys, where a second direction refines the
        # first; applying it here would turn a drag to the left edge into a
        # quarter whenever the window happened to be half-height already.
        mfs.run([snap_path(), "--exact", region])
    else:
        keep_below_bar(mons)


def keep_below_bar(mons):
    """Stop a freely dragged window from parking its title bar under the bar.

    hyprbars always reserves its height above the window, so dragging a window
    to the very top slides that bar behind the Omarchy bar. Hyprland has no
    rule that clamps this, so nudge the window back down on release.
    """
    try:
        window = json.loads(hypr("j/activewindow"))
    except Exception:
        return
    address = window.get("address")
    at = window.get("at")
    if not address or not at or not window.get("floating"):
        return
    try:
        # Spliced into a Lua expression below, so it is checked first.
        address = mfs.require_window_address(address)
    except mfs.MullionError:
        return

    mon = monitor_at(mons, at[0], at[1])
    reserved_top = (mon.get("reserved") or [0, 0, 0, 0])[1]
    lowest = mon["y"] + reserved_top + titlebar_height()

    if at[1] < lowest:
        mfs.run([mfs.tool("hyprctl"), "dispatch",
                 'hl.dsp.window.move({ window = "address:%s", x = %d, y = %d })'
                 % (address, at[0], lowest)])


if __name__ == "__main__":
    action = sys.argv[1] if len(sys.argv) > 1 else ""
    if action == "start":
        start()
    elif action == "end":
        end()
    elif action == "region":       # for debugging: print the region under the cursor
        pos = cursor_pos()
        print(region_at(monitors(), *pos) if pos else "no cursor")
    else:
        sys.exit("usage: mullion-drag-snap start|end|region")
