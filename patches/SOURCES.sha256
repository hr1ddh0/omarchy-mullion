# Build-input attestation for the hyprbars title-bar plugin.
#
# rebuild-hyprbars checks every line here. `pre` digests are the upstream
# sources as they arrive at the pinned commit, checked before anything local
# touches them; `post` digests are those same files once Mullion's four patches
# have been applied, checked immediately before the compiler runs.
#
# Together they make the build reproducible from published inputs: the commit
# fixes what is fetched, the `pre` digests prove the fetch was not tampered
# with, the patches are deterministic text substitutions, and the `post`
# digests prove the exact source that gets compiled on this machine is the
# exact source that was reviewed for this release. A mismatch at either point
# stops the build rather than compiling something nobody looked at.
#
# Regenerate with: ./patches/verify-pins --regenerate
#
# Sections are keyed by the hyprland-plugins commit, so a future Hyprland
# release adds a section rather than editing one.

[7644cecdb947060682891a0db2a0cdc5c0b9e704]
