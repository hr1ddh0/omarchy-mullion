#!/usr/bin/python3
"""Owner of patches/SOURCES.sha256: check build inputs, or regenerate them.

rebuild-hyprbars calls this twice per build, once before the patches are
applied and once after, so the exact source handed to the compiler is known to
match what this release was reviewed against. A maintainer adding support for a
new Hyprland version calls --regenerate to produce the section to paste in.

    verify-pins check pre  <plugins-commit> <hyprbars-source-dir>
    verify-pins check post <plugins-commit> <hyprbars-source-dir>
    verify-pins regenerate <plugins-commit>

`check` is the whole point, so it is deliberately unforgiving: an unknown
commit, a missing line, an extra file or one digit out of place all fail.
"""
import hashlib
import os
import re
import shutil
import subprocess
import sys
import tempfile

HERE = os.path.dirname(os.path.abspath(__file__))
MANIFEST = os.path.join(HERE, "SOURCES.sha256")
UPSTREAM = "https://github.com/hyprwm/hyprland-plugins.git"

COMMIT = re.compile(r"^[0-9a-f]{40}$")
SECTION = re.compile(r"^\[([0-9a-f]{40})\]$")
ENTRY = re.compile(r"^(pre|post)\s+([0-9a-f]{64})\s+(\S+)$")

# Only these are ever patched, so only these are attested. Listing them rather
# than digesting the whole tree keeps the manifest readable and makes an
# unexpected extra file a failure instead of a silent digest change.
FILES = ("barDeco.cpp", "main.cpp", "globals.hpp")

PATCHES = ("center-button-icons.py", "drag-snap-hooks.py",
           "icon-render-room.py", "mirror-button-icons.py")


def die(message):
    sys.exit("verify-pins: %s" % message)


def digest(path):
    with open(path, "rb") as handle:
        return hashlib.sha256(handle.read()).hexdigest()


def load(commit):
    """Every pre/post digest recorded for one pinned commit."""
    if not COMMIT.match(commit):
        die("%r is not a 40-character commit" % commit)
    wanted = {}
    current = None
    with open(MANIFEST, "r", encoding="utf-8") as handle:
        for number, line in enumerate(handle, 1):
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            header = SECTION.match(line)
            if header:
                current = header.group(1)
                continue
            entry = ENTRY.match(line)
            if not entry:
                die("%s line %d is not a digest line: %r" % (MANIFEST, number, line))
            if current is None:
                die("%s line %d comes before any [commit] section" % (MANIFEST, number))
            if current == commit:
                stage, value, name = entry.groups()
                if name not in FILES:
                    die("%s names %s, which is not an attested file" % (MANIFEST, name))
                wanted[(stage, name)] = value
    if not wanted:
        die("no digests recorded for %s.\n"
            "This Mullion release has not been built against that commit." % commit)
    return wanted


def check(stage, commit, source_dir):
    wanted = load(commit)
    missing = [name for name in FILES if (stage, name) not in wanted]
    if missing:
        die("no %s digest recorded for %s" % (stage, ", ".join(missing)))

    bad = []
    for name in FILES:
        path = os.path.join(source_dir, name)
        if not os.path.isfile(path):
            bad.append("%s is missing" % name)
            continue
        got = digest(path)
        if got != wanted[(stage, name)]:
            bad.append("%s\n    expected %s\n    got      %s"
                       % (name, wanted[(stage, name)], got))
    if bad:
        die("the %s-patch sources do not match the pin:\n  %s\n\n"
            "Nothing was built. The fetched source is not what this Mullion\n"
            "release was reviewed against, so compiling it is refused."
            % (stage, "\n  ".join(bad)))
    print("  %s-patch sources match the pin (%d files)" % (stage, len(FILES)))


def regenerate(commit):
    """Clone the pin into a scratch tree, patch it, and print the section."""
    if not COMMIT.match(commit):
        die("%r is not a 40-character commit" % commit)
    work = tempfile.mkdtemp(prefix="mullion-pins.")
    try:
        tree = os.path.join(work, "hlp")
        subprocess.run(
            ["/usr/bin/git", "-c", "transfer.fsckobjects=true",
             "-c", "fetch.fsckobjects=true", "clone", "--quiet",
             "--filter=blob:none", "--no-checkout", "--", UPSTREAM, tree],
            check=True)
        subprocess.run(["/usr/bin/git", "-C", tree, "checkout", "--quiet",
                        "--detach", commit], check=True)
        source = os.path.join(tree, "hyprbars")

        pre = {name: digest(os.path.join(source, name)) for name in FILES}
        for patch in PATCHES:
            result = subprocess.run(
                ["/usr/bin/python3", os.path.join(HERE, patch), source])
            if result.returncode != 0:
                die("%s does not apply at %s" % (patch, commit))
        post = {name: digest(os.path.join(source, name)) for name in FILES}

        print("\n[%s]" % commit)
        for name in FILES:
            print("pre   %s  %s" % (pre[name], name))
        for name in FILES:
            print("post  %s  %s" % (post[name], name))
    finally:
        shutil.rmtree(work, ignore_errors=True)


def main(argv):
    if len(argv) == 4 and argv[1] == "check" and argv[2] in ("pre", "post"):
        # verify-pins check <stage> <commit> <dir>  is the documented order;
        # accept it and nothing else.
        die("usage: verify-pins check {pre|post} <commit> <source-dir>")
    if len(argv) == 5 and argv[1] == "check":
        stage = argv[2]
        if stage not in ("pre", "post"):
            die("stage must be pre or post")
        return check(stage, argv[3], argv[4])
    if len(argv) == 3 and argv[1] == "regenerate":
        return regenerate(argv[2])
    sys.exit(__doc__.strip())


if __name__ == "__main__":
    sys.exit(main(sys.argv))
