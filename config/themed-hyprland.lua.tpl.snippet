-- Append to ~/.config/omarchy/themed/hyprland.lua.tpl (create it by copying
-- $OMARCHY_PATH/default/themed/hyprland.lua.tpl first). Makes the title bar and
-- the window borders follow whichever Omarchy theme is active.

-- Window elevation: a soft macOS-style drop shadow.
hl.config({
  decoration = {
    shadow = {
      enabled = true,
      -- A macOS drop shadow is large and very soft rather than tight: a wide
      -- blur at low opacity reads as elegant depth, where the same spread in a
      -- saturated colour read as a smear. Neutral black also lets the neon
      -- gradient border stay the thing that carries the accent.
      range = 32,
      render_power = 3,
      -- Cast downward, so the light reads as coming from above.
      offset = "0 10",
      color = "rgba(00000073)",
      -- Unfocused windows sit back, so the focused one is obviously on top.
      color_inactive = "rgba(00000038)",
    },
  },
})

if hl.plugin and hl.plugin.hyprbars then
  hl.config({
    plugin = {
      hyprbars = {
        bar_color = "rgba({{ lighter_background_strip }}f2)",
        col = { text = "rgba({{ foreground_strip }}ff)" },
        inactive_button_color = "rgba({{ muted_strip }}ff)",
      },
    },
  })
end
