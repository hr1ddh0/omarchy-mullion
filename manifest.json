{
  "schemaVersion": 1,
  "id": "hriddho.mullion",
  "name": "Mullion",
  "version": "1.1.0",
  "author": "Ashikuzzaman Hriddho",
  "license": "MIT",
  "description": "macOS traffic lights or Windows 11 caption buttons for every window, with drag-to-edge snapping, split screen, edge resize and minimize to the bar.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Mullion",
    "description": "Settings for Mullion's window controls, snapping and title bars. Shows a setup icon until the title bars are installed.",
    "category": "Compositor",
    "aliases": [
      "mullion",
      "window controls",
      "titlebar",
      "title bar",
      "macos",
      "mac",
      "traffic lights",
      "windows",
      "windows 11",
      "caption buttons",
      "minimize",
      "maximize",
      "close",
      "snap",
      "split screen",
      "tiling",
      "drag",
      "resize",
      "hyprbars"
    ],
    "allowMultiple": false,
    "defaultSection": "left",
    "defaults": {
      "checkIntervalMinutes": 10,
      "alwaysShow": false
    },
    "schema": [
      {
        "key": "checkIntervalMinutes",
        "type": "number",
        "label": "Check interval (minutes)"
      },
      {
        "key": "alwaysShow",
        "type": "boolean",
        "label": "Show even when title bars are healthy"
      }
    ]
  }
}
